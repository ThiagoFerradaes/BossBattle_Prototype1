  m_TableData:
  - m_Id: 1855119337017344
    m_Localized: Sem problemas.
    m_Metadata:
      m_Items: []
  - m_Id: 1855119357988864
    m_Localized: "Por que voc\xEA n\xE3o pede a ele?"
    m_Metadata:
      m_Items: []
  - m_Id: 1855119357988865
    m_Localized: Isso pode esperar?
    m_Metadata:
      m_Items: []
  - m_Id: 1855119357988867
    m_Localized: ...Mas vou falar com ele.
    m_Metadata:
      m_Items: []
  - m_Id: 1855119357988868
    m_Localized: "Por que voc\xEA n\xE3o quer falar com ele?"
    m_Metadata:
      m_Items: []
  - m_Id: 1855119357988869
    m_Localized: "Agora n\xE3o vai dar."
    m_Metadata:
      m_Items: []
  - m_Id: 1855119357988871
    m_Localized: 'Ok. '
    m_Metadata:
      m_Items: []
  - m_Id: 1855119357988872
    m_Localized: "Pe\xE7a voc\xEA mesma."
    m_Metadata:
      m_Items: []
  - m_Id: 1855119357988873
    m_Localized: 'Estamos ocupados demais. '
    m_Metadata:
      m_Items: []
  - m_Id: 2914983605784576
    m_Localized: 'Preciso que construa algo. '
    m_Metadata:
      m_Items: []
  - m_Id: 2914983630950400
    m_Localized: "N\xE3o precisa pedir desculpas."
    m_Metadata:
      m_Items: []
  - m_Id: 2914983630950401
    m_Localized: "Como t\xEAm sido os trabalhos?"
    m_Metadata:
      m_Items: []
  - m_Id: 2914983630950402
    m_Localized: "N\xE3o preciso de nada!"
    m_Metadata:
      m_Items: []
  - m_Id: 2914983630950403
    m_Localized: Consigo arrumar essas coisas?
    m_Metadata:
      m_Items: []
  - m_Id: 2914983630950404
    m_Localized: E como eu consigo isso?
    m_Metadata:
      m_Items: []
  - m_Id: 2914983630950405
    m_Localized: "Por que voc\xEA est\xE1 fazendo isso?"
    m_Metadata:
      m_Items: []
  - m_Id: 2914983630950406
    m_Localized: "Quando foi a \xFAltima vez que voc\xEA dormiu?"
    m_Metadata:
      m_Items: []
