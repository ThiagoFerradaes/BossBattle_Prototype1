  - m_Id: 4996005201793028
    m_Localized: Bastian alternative Two long
    m_Metadata:
      m_Items: []
  - m_Id: 4996005201793029
    m_Localized: Bastian alternative Supreme
    m_Metadata:
      m_Items: []
  - m_Id: 4996005201793030
    m_Localized: Bastian alternative Supreme short
    m_Metadata:
      m_Items: []
  - m_Id: 4996005201793031
    m_Localized: Bastian alternative Supreme long
    m_Metadata:
