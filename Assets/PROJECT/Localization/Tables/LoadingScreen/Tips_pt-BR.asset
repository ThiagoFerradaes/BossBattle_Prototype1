  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tips_pt-BR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: 439063482cb944a4caaa1f67c770bf4a, type: 2}
  m_Metadata:
    m_Items:
    - rid: 9208132965622087766
  m_TableData:
  - m_Id: 79546634240
    m_Localized: "A maior cidade do Mar das Serpentes era Doca Alta, e foi destru\xEDda
      no primeiro ataque dos monstros, h\xE1 17 anos. "
    m_Metadata:
      m_Items: []
  - m_Id: 101252157440
    m_Localized: "Rel\xEDquias s\xE3o objetos poderosos, com o poder de alterar a
      realidade das mais diversas formas. "
    m_Metadata:
      m_Items: []
  - m_Id: 112463532032
    m_Localized: "A Companhia Mercantil \xE9 uma empresa com poderes de estado: tem
      seu pr\xF3prio ex\xE9rcito e prerrogativa para fundar col\xF4nias. "
    m_Metadata:
      m_Items: []
  - m_Id: 70513885532160
    m_Localized: Use WASD para se mover.
    m_Metadata:
      m_Items: []
  - m_Id: 70513914892288
    m_Localized: Aperte E para interagir com personagens e objetos.
    m_Metadata:
      m_Items: []
  - m_Id: 70513914892289
    m_Localized: "\xC0s vezes, conversar com um personagem abre novas op\xE7\xF5es
      de di\xE1logo com outros. "
    m_Metadata:
      m_Items: []
  - m_Id: 70513914892290
    m_Localized: "Destrua todos os tent\xE1culos para derrubar o Kraken."
    m_Metadata:
      m_Items: []
  - m_Id: 70513914892291
    m_Localized: "Ataque v\xE1rios tent\xE1culos ao mesmo tempo para causar mais
      dano."
    m_Metadata:
      m_Items: []
  - m_Id: 70513914892292
    m_Localized: "O Kraken fica enfurecido ap\xF3s sofrer muito dano. Fique atento."
    m_Metadata:
      m_Items: []
  - m_Id: 113173325238272
    m_Localized: 'Dica:'
    m_Metadata:
      m_Items:
      - rid: 9208132965622087766
  - m_Id: 6463908430303232
    m_Localized: A investida concede invulnerabilidade por um breve momento. Use-a
      para evitar ataques.
    m_Metadata:
      m_Items: []
  - m_Id: 6463908501606400
    m_Localized: "Os tent\xE1culos demoram a se recuperar ap\xF3s uma pancada. Ataque
      enquanto est\xE3o atordoados."
    m_Metadata:
      m_Items: []
