  m_TableData:
  - m_Id: 17944891392
    m_Localized: 'One of your heroes seems to have fallen ill, but don''t worry:
      one of your colleagues used to be a healer, and she might have a solution.
      You can talk to her, or go to the map table to start planning an excursion
      against the local monsters.'
    m_Metadata:
      m_Items: []
  - m_Id: 323258097946624
    m_Localized: "What a joy! \n\nIt seems you defeated the Great Kraken. \n\nA new
      character is ready to be used in battle!"
    m_Metadata:
      m_Items: []
  - m_Id: 339668278792192
    m_Localized: Heads Up!
    m_Metadata:
      m_Items: []
