  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Responses DemoBgf_pt-BR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: b0fcfe90766a923408bd66a7e19543ef, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 152355557376
    m_Localized: 'Retornarei com a tinta em breve. '
    m_Metadata:
      m_Items: []
  - m_Id: 152368140288
    m_Localized: Onde eu consigo isso?
    m_Metadata:
      m_Items: []
  - m_Id: 152368140289
    m_Localized: "Tem certeza que ser\xE1 suficiente? "
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729280
    m_Localized: "Me conte mais sobre voc\xEA."
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729281
    m_Localized: "O que voc\xEA acha dos nossos colegas?"
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729282
    m_Localized: "N\xE3o quero falar de mais nada."
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729283
    m_Localized: "Como voc\xEA virou Cors\xE1rio?"
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729284
    m_Localized: Como era ser da Guarda Mercantil?
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729285
    m_Localized: Quero falar sobre outra coisa.
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729286
    m_Localized: "N\xE3o acha seu trabalho importante?"
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729287
    m_Localized: "Voc\xEA trabalha sozinho?"
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729288
    m_Localized: Discordo.
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729289
    m_Localized: Faz sentido.
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729290
    m_Localized: Como foi seu treinamento?
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729291
    m_Localized: "Por que tanto \xF3dio?"
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729292
    m_Localized: Hawke?
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729293
    m_Localized: "Voc\xEA n\xE3o \xE9 assim."
    m_Metadata:
      m_Items: []
  - m_Id: 5007920882913280
    m_Localized: Quero falar sobre Lillian.
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079104
    m_Localized: Quero falar sobre Cyrus.
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079105
    m_Localized: Quero falar sobre Bertrand.
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079106
    m_Localized: Estamos falando da mesma Lillian?
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079107
    m_Localized: O que mais sabe sobre ela?
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079108
    m_Localized: Vamos falar sobre outra pessoa.
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079109
    m_Localized: "Voc\xEA n\xE3o pode falar assim comigo!"
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079110
    m_Localized: Sinto muito
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079111
    m_Localized: "O que voc\xEA quer dizer com peculiar?"
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079112
    m_Localized: "O que mais voc\xEA sabe sobre ele?"
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079113
    m_Localized: "Prefiro n\xE3o contar."
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079114
    m_Localized: "Est\xE1 bem"
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079115
    m_Localized: "Ele j\xE1 construiu algo para voc\xEA?"
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079116
    m_Localized: "Isso n\xE3o faz sentido!"
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079117
    m_Localized: "S\xF3... Tome cuidado."
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079118
    m_Localized: "Isso n\xE3o \xE9 justo."
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079119
    m_Localized: 'Vamos mudar de assunto. '
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079120
    m_Localized: "Vou te deixar s\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079121
    m_Localized: "Para quem voc\xEA est\xE1 trabalhando atualmente?"
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079122
    m_Localized: "Como voc\xEA aprendeu a lutar assim?"
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079123
    m_Localized: "E o que voc\xEA faz l\xE1?"
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079124
    m_Localized: "J\xE1 trabalhou para ambas as coroas? "
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079125
    m_Localized: Deveria ligar.
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079126
    m_Localized: "Est\xE1 certo."
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079127
    m_Localized: "Onde voc\xEA a encontrou?"
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079128
    m_Localized: "Voc\xEA gosta bastante de rel\xEDquias."
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079129
    m_Localized: Quero falar sobre Bastian.
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079130
    m_Localized: "Ela n\xE3o gosta de voc\xEA."
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079131
    m_Localized: Para te proteger.
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079132
    m_Localized: Para evitar problemas.
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079133
    m_Localized: "N\xE3o sei. "
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079134
    m_Localized: 'Estou com a Tinta de Lula. '
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079135
    m_Localized: "Por que n\xE3o se chamaria de \"Imaculada\"?"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
