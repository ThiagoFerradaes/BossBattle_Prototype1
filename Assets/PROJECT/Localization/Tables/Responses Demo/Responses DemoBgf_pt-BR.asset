  m_TableData:
  - m_Id: 152355557376
    m_Localized: 'Retornarei com a tinta em breve. '
    m_Metadata:
      m_Items: []
  - m_Id: 152368140288
    m_Localized: Onde eu consigo isso?
    m_Metadata:
      m_Items: []
  - m_Id: 152368140289
    m_Localized: "Tem certeza que ser\xE1 suficiente? "
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729280
    m_Localized: "Me conte mais sobre voc\xEA."
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729281
    m_Localized: "O que voc\xEA acha dos nossos colegas?"
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729282
    m_Localized: "N\xE3o quero falar de mais nada."
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729283
    m_Localized: "Como voc\xEA virou Cors\xE1rio?"
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729284
    m_Localized: Como era ser da Guarda Mercantil?
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729285
    m_Localized: Quero falar sobre outra coisa.
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729286
    m_Localized: "N\xE3o acha seu trabalho importante?"
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729287
    m_Localized: "Voc\xEA trabalha sozinho?"
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729288
    m_Localized: Discordo.
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729289
    m_Localized: Faz sentido.
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729290
    m_Localized: Como foi seu treinamento?
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729291
    m_Localized: "Por que tanto \xF3dio?"
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729292
    m_Localized: Hawke?
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729293
    m_Localized: "Voc\xEA n\xE3o \xE9 assim."
    m_Metadata:
      m_Items: []
