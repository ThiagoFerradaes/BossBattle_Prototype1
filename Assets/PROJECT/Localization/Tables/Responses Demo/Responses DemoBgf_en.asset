  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Responses DemoBgf_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: b0fcfe90766a923408bd66a7e19543ef, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 152355557376
    m_Localized: "I\u2019ll be back with the Squid Ink soon."
    m_Metadata:
      m_Items: []
  - m_Id: 152368140288
    m_Localized: 'Where can I find it? '
    m_Metadata:
      m_Items: []
  - m_Id: 152368140289
    m_Localized: "Are you sure it\u2019ll be enough?"
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729280
    m_Localized: Tell me more about yourself.
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729281
    m_Localized: What are your thoughts on our companions?
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729282
    m_Localized: "I don\u2019t want to talk about anything else."
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729283
    m_Localized: How did you become a Privateer?
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729284
    m_Localized: What was it like being part of the Merchant Guard?
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729285
    m_Localized: I want to talk about something else.
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729286
    m_Localized: "You don\u2019t think your job is important?"
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729287
    m_Localized: Do you work alone?
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729288
    m_Localized: I disagree.
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729289
    m_Localized: Makes sense.
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729290
    m_Localized: What was your training like?
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729291
    m_Localized: Why so hateful?
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729292
    m_Localized: Hawke?
    m_Metadata:
      m_Items: []
  - m_Id: 2154118933729293
    m_Localized: "You\u2019re not like that."
    m_Metadata:
      m_Items: []
  - m_Id: 5007920882913280
    m_Localized: I want to talk about Lillian.
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079104
    m_Localized: I want to talk about Cyrus.
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079105
    m_Localized: I want to talk about Bertrand.
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079106
    m_Localized: Are we talking about the same Lillian?
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079107
    m_Localized: What else do you know about her?
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079108
    m_Localized: "Let\u2019s talk about someone else."
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079109
    m_Localized: "You can\u2019t talk to me like that!"
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079110
    m_Localized: "I\u2019m sorry."
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079111
    m_Localized: What do you mean, peculiar?
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079112
    m_Localized: What else do you know about him?
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079113
    m_Localized: "I\u2019d rather not."
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079114
    m_Localized: Alright.
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079115
    m_Localized: Has he ever built you something?
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079116
    m_Localized: That makes no sense!
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079117
    m_Localized: "Just\u2026 be careful."
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079118
    m_Localized: "That\u2019s not fair."
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079119
    m_Localized: "Let\u2019s change the subject."
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079120
    m_Localized: "I\u2019ll leave you be."
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079121
    m_Localized: Who are you currently working for?
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079122
    m_Localized: How did you learn to fight like that?
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079123
    m_Localized: "And what do you do once you\u2019re there?"
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079124
    m_Localized: You've worked for both crowns?
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079125
    m_Localized: Well, you should.
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079126
    m_Localized: "You\u2019re right."
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079127
    m_Localized: Where did you find it?
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079128
    m_Localized: You like relics a lot.
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079129
    m_Localized: I want to talk about Bastian.
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079130
    m_Localized: "She doesn\u2019t like you."
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079131
    m_Localized: To protect you.
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079132
    m_Localized: To avoid problems.
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079133
    m_Localized: "I don\u2019t know."
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079134
    m_Localized: I have the Squid Ink.
    m_Metadata:
      m_Items: []
  - m_Id: 5007920908079135
    m_Localized: "Why wouldn\u2019t you call yourself \u201CImmaculate\u201D?"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
