{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "6291bd23eb0848018add8d9eefdbac04",
    "m_Title": "",
    "m_Content": "Multiply by -1, as we want our Z becomming close to the camera to be positive (facing the camera=poiting up when rotated)",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1736.0,
        "y": -767.0,
        "width": 200.0,
        "height": 100.0
    },
    "m_Group": {
        "m_Id": "b0d4f79df5b3404a8f7a3eccc796ad06"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "62d3943cc29648c3903fc08ca516370c",
    "m_Title": "",
    "m_Content": "Planes are imported laying flat on the ground, so we displace based the Z axis instead of the Y axis. We then rotate the obj by 90 degrees in the X axis, so they stand up, and the displacement appears to be based on the Y axis (height)",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -2223.0,
        "y": -1071.0,
        "width": 200.0,
        "height": 120.0
    },
    "m_Group": {
        "m_Id": "b0d4f79df5b3404a8f7a3eccc796ad06"
    }
}

